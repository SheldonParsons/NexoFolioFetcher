{
  "name": "nexofolio-fetcher",
  "description": "NexoFolio Fetcher Chrome panel",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "node scripts/build-collect-contract.mjs && node scripts/build-icons.mjs && wxt build",
    "contract:sync": "node scripts/build-collect-contract.mjs ../NexoFolio/contracts/collect/v1",
    "package:dev": "node scripts/release-dev.mjs --package-only",
    "typecheck": "wxt prepare && vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "release:dev": "node scripts/release-dev.mjs"
  },
  "dependencies": {
    "lucide": "1.43.0",
    "morphicons": "1.7.1",
    "reka-ui": "2.10.4",
    "vue": "3.5.42",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/search": "6.7.2"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "@wxt-dev/module-vue": "1.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ali-oss": "6.23.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "wxt": "0.21.4"
  }
}
